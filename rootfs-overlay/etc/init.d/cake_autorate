#!/bin/sh /etc/rc.common
# Start the CAKE autorate controller after sqm_cake has created the qdiscs.
START=96
STOP=9
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/cake_autorate
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}
