#!/bin/sh /etc/rc.common
# Create/bring up wlan0 AFTER tri_eth_up (S19) has loaded tri_kcfe_res.
# Bringing any netdev UP before that load panics tri_kcfe_res (known init
# bug). The peanut driver's config / cali-to-device path starts when the
# netdev comes up, and the chip's heartbeat deadline is ~25 s after
# plat_ready (~18.5 s), so S21 is comfortably in time.
START=21

start() {
    i=0
    while [ $i -lt 15 ]; do
        [ -d /sys/class/ieee80211/phy0 ] && break
        sleep 1; i=$((i+1))
    done
    iw phy phy0 interface add wlan0 type managed 2>/dev/null
    ip link set wlan0 up 2>/dev/null
    echo "WIFI_NET: wlan0 up" > /dev/console
}

stop() { :; }
