#!/bin/sh /etc/rc.common
# Persistent operating-mode rollback watcher.  procd respawns it if killed;
# it only acts while /etc/config/mode has pending=1 and the deadline expired.
START=16
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/mode watch
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
